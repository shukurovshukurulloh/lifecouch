DATABASE_URL="postgresql://lifecouch:lifecouch123@localhost:5432/lifecouch?schema=public"
PORT=4000
JWT_SECRET="change-me-in-production"
WEB_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Ixtiyoriy — bo'lmasa billing checkout/webhook lokal stub orqali simulyatsiya qilinadi.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Ixtiyoriy — bo'lmasa AI coach javoblari lokal stub orqali simulyatsiya qilinadi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Ixtiyoriy — bo'lmasa xatolar faqat konsolga yoziladi (stub rejim, monitoring/sentry.ts).
SENTRY_DSN=
# Ixtiyoriy — "true" bo'lsa, ro'yxatdan o'tish faqat admin yaratgan ishlatilmagan
# taklifnoma kodi bilan ishlaydi (beta-reliz, auth/routes.ts). Default: yo'q (ochiq ro'yxat).
BETA_INVITE_REQUIRED=
# Ixtiyoriy — Google Cloud Console'dagi OAuth 2.0 Client ID. Bo'lmasa "Google bilan
# kirish" tugmasi frontend'da ko'rinmaydi (auth/googleClient.ts). apps/web/.env.example
# dagi VITE_GOOGLE_CLIENT_ID bilan bir xil qiymat bo'lishi kerak.
GOOGLE_CLIENT_ID=
