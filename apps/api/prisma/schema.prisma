generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  COACH
  ADMIN
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum SessionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CoachStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Google orqali yaratilgan hisoblarda yo'q (null) — login handler buni tekshiradi.
  passwordHash String?
  /// Google "sub" claim'i — Google orqali kirgan/bog'langan hisoblarda o'rnatiladi.
  googleId     String?  @unique
  name         String
  avatarUrl    String?
  bio          String?
  focusArea    String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach        Coach?
  goals        Goal[]
  sessions     Session[]
  subscription Subscription?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  invoices            Invoice[]
  aiMessages          AiMessage[]

  createdInviteCodes InviteCode[] @relation("CreatedInviteCodes")
  usedInviteCode     InviteCode?  @relation("UsedInviteCode")
}

/// Persisted, rotatable refresh token backing the JWT access-token flow.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Single-use token emailed to a user to authorize a password reset.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Public profile + rate card for a User applying to (or approved as) a COACH.
/// `status` gates both public visibility and the COACH role grant — see admin/routes.ts.
model Coach {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty      String
  priceCents     Int
  currency       String      @default("USD")
  ratingAvg      Float?
  status         CoachStatus @default(PENDING)
  rejectionNote  String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  sessions          Session[]
  availabilitySlots AvailabilitySlot[]
  payoutRequests    PayoutRequest[]

  @@index([status])
}

/// An open time slot a coach publishes; becomes booked when a Session claims it.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())

  session Session?

  @@index([coachId, startsAt])
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  targetDate  DateTime?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  habits Habit[]
}

model Habit {
  id        String         @id @default(cuid())
  goalId    String
  goal      Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  frequency HabitFrequency @default(DAILY)
  createdAt DateTime       @default(now())

  checkIns CheckIn[]
}

model CheckIn {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  completed Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

/// A booked coaching session between a User and a Coach (not an auth/HTTP session).
model Session {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachId         String
  coach           Coach             @relation(fields: [coachId], references: [id], onDelete: Cascade)
  slotId          String?           @unique
  slot            AvailabilitySlot? @relation(fields: [slotId], references: [id])
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  status          SessionStatus     @default(PENDING)
  videoLink       String?
  /// Bron paytida `coach.priceCents`/`currency`dan suratga olinadi (payouts/service.ts
  /// coach daromadini shundan hisoblaydi) — coach keyin narxini o'zgartirsa ham tarixiy
  /// daromad o'zgarmasin. Eski (bu ustun qo'shilishidan oldingi) sessiyalarda null.
  priceCents      Int?
  currency        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId])
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan    @default(FREE)
  status               SubscriptionStatus  @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

/// Billing tarixi yozuvi — obuna yaratilganda/yangilanganda qo'shiladi (Stripe invoice yoki stub to'lov).
model Invoice {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  amountCents     Int
  currency        String           @default("USD")
  status          String
  stripeInvoiceId String?          @unique
  createdAt       DateTime         @default(now())

  @@index([userId])
}

/// Beta-reliz uchun bir martalik taklifnoma kodi — admin yaratadi, `/auth/register`
/// `BETA_INVITE_REQUIRED=true` bo'lganda ro'yxatdan o'tish uchun shuni talab qiladi.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  createdById String
  createdBy   User      @relation("CreatedInviteCodes", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?   @unique
  usedBy      User?     @relation("UsedInviteCode", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

/// Coach'ning bir martalik pul yechish so'rovi (qo'lda boshqariladi — admin
/// tashqarida pul jo'natib, statusni PAID/REJECTED qiladi). Balans hisobi
/// (payouts/service.ts) COMPLETED sessiyalar yig'indisidan hisoblanadi, alohida
/// "balans" ustuni saqlanmaydi.
model PayoutRequest {
  id          String       @id @default(cuid())
  coachId     String
  coach       Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String
  status      PayoutStatus @default(PENDING)
  note        String?
  adminNote   String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?

  @@index([coachId])
  @@index([status])
}

/// AI coach bilan suhbat tarixidagi bitta xabar (foydalanuvchidan yoki AI javobi).
model AiMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}
