{
  "name": "lifecouch",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @lifecouch/api dev",
    "dev:web": "pnpm --filter @lifecouch/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @lifecouch/api prisma:generate",
    "prisma:migrate": "pnpm --filter @lifecouch/api prisma:migrate"
  }
}
